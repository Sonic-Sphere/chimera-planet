{
  "name": "chimera-planet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run wasm:ensure && vite",
    "build": "bun run wasm:ensure && bun run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun run wasm:ensure && cd vendor/chimera && bun test tests",
    "wasm": "cd vendor/chimera && bun run wasm",
    "wasm:ensure": "test -s vendor/chimera/src/wasm/chimera.wasm || bun run wasm"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.2.1",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
